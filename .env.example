# Rename to .env and fill in your values

# OpenAI API Key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your_key_here

# Models (defaults work well, change if needed)
CHAT_MODEL=gpt-4o-mini          # Chat model (gpt-4o-mini is cheap + fast)
STT_MODEL=whisper-1              # Speech-to-text model
TTS_MODEL=tts-1                  # Text-to-speech model
TTS_VOICE=nova                   # Voice: alloy, echo, fable, onyx, nova, shimmer


# ── .env — add these three lines below your existing config ──────────────
# MongoDB connection (local default)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=process_improvement_agent

# JWT secret — change this to a long random string in production
JWT_SECRET=yolexlabs-process-agent-jwt-secret-2026-change-me

# ── Default manager account (created on first startup if DB is empty) ────────
DEFAULT_MANAGER_EMAIL=admin@yolexlabs.com
DEFAULT_MANAGER_PASSWORD=Admin@1234
